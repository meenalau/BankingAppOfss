
CREATE SEQUENCE CUST_SEQ START WITH 101 INCREMENT BY 1 NOCACHE;
CREATE SEQUENCE ACC_SEQ  START WITH 100111 INCREMENT BY 1 NOCACHE;
CREATE SEQUENCE TRN_SEQ      START WITH 26001 INCREMENT BY 1 NOCACHE;

select  CUST_SEQ.nextval from dual;
select  ACC_SEQ.nextval from dual;
select  TRN_SEQ.nextval from dual;



CREATE TABLE CUSTOMEROJET (
    customer_id NUMBER PRIMARY KEY,
    name        VARCHAR2(100) NOT NULL,
    email       VARCHAR2(100) NOT NULL
);


CREATE TABLE ACCOUNTOJET (
    account_id  NUMBER PRIMARY KEY,
    customer_id NUMBER NOT NULL,
    balance     NUMBER(15,2) DEFAULT 0,
    CONSTRAINT fk_account_customer
        FOREIGN KEY (customer_id) REFERENCES CUSTOMEROJET(customer_id)
);


CREATE TABLE TRANSACTIONOJET (
    transaction_id    NUMBER PRIMARY KEY,
    account_id        NUMBER NOT NULL,
    amount             NUMBER(15,2) NOT NULL,
    type               VARCHAR2(20) NOT NULL,
    transaction_date  TIMESTAMP DEFAULT SYSTIMESTAMP,
    CONSTRAINT fk_transaction_account
        FOREIGN KEY (account_id) REFERENCES ACCOUNTOJET(account_id)
);


select * from CUSTOMEROJET;
select * from ACCOUNTOJET;
select * from TRANSACTIONOJET;


delete  from CUSTOMEROJET
delete  from ACCOUNTOJET;
delete  from TRANSACTIONOJET;

